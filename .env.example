# AI YouTube Automation Pro - configuration
# Copy to .env (setup.bat does this) or fill keys in the dashboard: API Settings.
# NEVER commit .env. Leave a key empty to keep that provider disabled.
# Everything works with NO keys using the free providers (offline writer, storyboard images,
# Ken Burns motion, Edge voices). Paid providers only run after you approve the cost estimate.

# --- Claude (scripts, ideas, SEO). Paid API credits - NOT included in Claude Pro/Max chat plans.
ANTHROPIC_API_KEY=
# claude-opus-5-5 (best) | claude-sonnet-5-5 (cheaper) | claude-haiku-5-5 (cheapest)
ANTHROPIC_MODEL=claude-opus-5-5

# --- Voices
ELEVENLABS_API_KEY=
OPENAI_API_KEY=

# --- Images
STABILITY_API_KEY=
REPLICATE_API_TOKEN=
# Optional: removes Pollinations watermark / raises free limits
POLLINATIONS_TOKEN=

# --- Video clips
RUNWAY_API_KEY=
LUMA_API_KEY=

# --- YouTube
# Free API key for trend research (Google Cloud > Credentials > API key, YouTube Data API v3 enabled)
YOUTUBE_API_KEY=
# OAuth client (Desktop app) JSON for uploading - default location shown; keep it OUT of source control
GOOGLE_CLIENT_SECRETS_FILE=data/secrets/client_secret.json

# --- App
YTAUTO_HOST=127.0.0.1
YTAUTO_PORT=8000
# Optional: path to your own ffmpeg.exe (otherwise the bundled imageio-ffmpeg build is used)
FFMPEG_BINARY=
